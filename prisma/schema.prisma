// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}


// Cache entries table for L3 cache
model CacheEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("cache_entries")
}

// Application Settings
model AppSetting {
  id          String   @id @default(uuid())
  logicalName String   @unique @map("logical_name")
  displayName String   @map("display_name")
  value       String?
  hasAction   Boolean  @default(false) @map("has_action")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Chart of Accounts
model ChartOfAccount {
  id          String        @id @default(uuid())
  chartNumber String        @unique @map("chart_number")
  accounts    MainAccount[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("chart_of_accounts")
}

// Main Accounts
model MainAccount {
  id            String         @id @default(uuid())
  chartNumber   String         @map("chart_number")
  accountNumber String         @map("account_number")
  chart         ChartOfAccount @relation(fields: [chartNumber], references: [chartNumber], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([chartNumber, accountNumber])
  @@index([chartNumber])
  @@map("main_accounts")
}

// Financial Dimensions
model FinancialDimension {
  id              String                    @id @default(uuid())
  financialKey    String                    @unique @map("financial_key")
  dimensionValues FinancialDimensionValue[]
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@map("financial_dimensions")
}

// Financial Dimension Values
model FinancialDimensionValue {
  id                    String             @id @default(uuid())
  financialDimensionKey String             @map("financial_dimension_key")
  value                 String
  description           String?
  dimension             FinancialDimension @relation(fields: [financialDimensionKey], references: [financialKey], onDelete: Cascade)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@unique([financialDimensionKey, value])
  @@index([financialDimensionKey])
  @@map("financial_dimension_values")
}

// Account Customer Invoice Mappings
model AccountCustomerInvoiceMapping {
  id              String   @id @default(uuid())
  name            String
  customerAccount String   @map("customer_account")
  invoiceAccount  String   @map("invoice_account")
  serviceType     Int      @map("service_type") // ServiceTypes enum
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([serviceType])
  @@map("account_customer_invoice_mappings")
}

// Ledger Entry Batch Counter
model LedgerEntryBatchCounter {
  id                 String   @id @default(uuid())
  companyId          String   @unique @map("company_id")
  lastBatchNumber    BigInt   @default(0) @map("last_batch_number")
  companyBatchPrefix String   @map("company_batch_prefix")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ledger_entry_batch_counters")
}

// Ledger Voucher Counter
model LedgerVoucherCounter {
  id                        String   @id @default(uuid())
  journalName               String   @map("journal_name")
  lastNumber                BigInt   @default(0) @map("last_number")
  companyId                 String   @map("company_id")
  relatedSettingLogicalName String   @map("related_setting_logical_name")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([companyId, journalName])
  @@index([companyId])
  @@map("ledger_voucher_counters")
}
