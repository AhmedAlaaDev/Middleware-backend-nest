# ============================================
# MG D365FO Middleware - Configuration Template
# ============================================
# Copy to .env.development / .env.production / .env.local and fill secrets
# from .env.secrets (gitignored inventory of all secret values).
# ============================================

# Application
# NODE_ENV controls environment-specific behavior and config file selection.
# PORT is the HTTP listen port; PREFIX is the global API route prefix.
# ALLOWED_CORS_ORIGINS is a comma-separated browser origin allowlist.
# ADMIN_API_KEY protects scheduler and settings automation endpoints.
NODE_ENV=development
PORT=3000
PREFIX=/api
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://192.168.1.x:3000
ADMIN_API_KEY=''


# Databases
# MONGODB_URI stores application data; MONGODB_MAX_POOL_SIZE limits connections.
# LOG_MONGODB_URI stores operational logs; use an off-host database in production.
# LOG_RETENTION_DAYS controls the MongoDB TTL archive period.
MONGODB_URI=mongodb+srv://<username>:<password>@d365fomiddleware.wn13sqd.mongodb.net/?appName=D365FOMiddleware
MONGODB_MAX_POOL_SIZE=5
LOG_MONGODB_URI=mongodb+srv://<username>:<password>@<off-host-cluster>/logs
LOG_RETENTION_DAYS=90


# Authentication
# Access tokens are short-lived API credentials; refresh tokens renew sessions.
JWT_ACCESS_SECRET=''
JWT_ACCESS_TTL='15m'
JWT_REFRESH_SECRET=''
JWT_REFRESH_TTL='30d'

# Microsoft Entra workforce authentication and local administrator bootstrap.
# Register separate development and production redirect URIs in Entra.
# Configure the optional ID-token `acct` claim; only acct=0 members pass.
ENTRA_TENANT_ID=''
ENTRA_CLIENT_ID=''
ENTRA_CLIENT_SECRET=''
ENTRA_CLIENT_SECRET_EXPIRES_AT=''
ENTRA_REDIRECT_URI='http://localhost:3000/api/v1/auth/microsoft/callback'
ENTRA_ALLOWED_EMAIL_DOMAINS='example.com'
FRONTEND_AUTH_CALLBACK_URL='http://localhost:3000/microsoft-callback'
ADMIN_EMAIL='platform.admin@example.com'
ADMIN_INITIAL_PASSWORD=''

# Used only by pnpm migrate:legacy-admin; run without --apply for a dry run.
LEGACY_ADMIN_EMAIL=''


# Dynamics 365 Finance & Operations
# Service-principal credentials and the target D365FO resource URL.
# D365FO_RESOURCE: local / non-production (onebox or sandbox).
# D365FO_RESOURCE_PROD: used when NODE_ENV=production (deploy target).
D365FO_TENANT_ID=
D365FO_CLIENT_ID=
D365FO_CLIENT_SECRET=
D365FO_RESOURCE=https://mesco.sandbox.operations.eu.dynamics.com
D365FO_RESOURCE_PROD=https://mesco.sandbox.operations.eu.dynamics.com
D365FO_AUTHORITY=https://login.microsoftonline.com


# Resilience and caching
# Circuit-breaker values control when failing D365FO calls are temporarily blocked.
# Cache TTL values are minutes for memory, Redis, and Mongo cache layers.
# CACHE_REDIS_* points disposable cache traffic at the cache-only Redis service.
# HTTP_TIMEOUT is the default Axios timeout; D365FO_BULK_HTTP_TIMEOUT covers
# cash-out bulk custom-service posts (~100 lines / TTS) that exceed 2 minutes.
HTTP_TIMEOUT=120000
D365FO_BULK_HTTP_TIMEOUT=600000
CIRCUIT_BREAKER_TIMEOUT=120000
CIRCUIT_BREAKER_RESET_TIMEOUT=120000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
CIRCUIT_BREAKER_ENABLED=true

CACHE_L1_TTL=5
CACHE_L2_TTL=30
CACHE_L3_TTL=120
CACHE_REDIS_HOST=cache-redis
CACHE_REDIS_PORT=6379

# Durable queue and operational-log Redis
# REDIS_* configures BullMQ and Redis Streams; this Redis must not evict keys.
# LOG_REDIS_STREAM names the event stream and caps its approximate entry count.
REDIS_HOST=redis
REDIS_PORT=6379
LOG_REDIS_STREAM=app:logs:v1
LOG_REDIS_STREAM_MAX_LENGTH=200000


# Request/response body capture on operational logs
# LOG_CAPTURE_PAYLOADS=false stops bodies (such as the Cash-Out Lines contract)
# from being stored; LOG_PAYLOAD_MAX_BYTES caps each captured body, larger ones
# are truncated and flagged.
LOG_CAPTURE_PAYLOADS=true
LOG_PAYLOAD_MAX_BYTES=1048576
LOG_PAYLOAD_MAX_STRING_LENGTH=32768
LOG_PAYLOAD_MAX_DEPTH=12


# Scheduled cleanup
# SCHEDULER_ENABLED controls cleanup jobs; retention values control deletion age.
SCHEDULER_ENABLED=true
TOKEN_CLEANUP_RETENTION_DAYS=30  # Keep revoked tokens for 30 days
TEMP_FILE_CLEANUP_RETENTION_HOURS=24

# Optional (local tooling only)
AZURE_PERSONAL_TOKEN=
