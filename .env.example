# ============================================
# MG D365FO Middleware - Development Environment
# ============================================

# Application Configuration
NODE_ENV=development
PORT=3000
PREFIX=/api
ALLOWED_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://192.168.1.x:3000
ADMIN_API_KEY=''


# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@d365fomiddleware.wn13sqd.mongodb.net/?appName=D365FOMiddleware
MONGODB_MAX_POOL_SIZE=5


# JWT Authentication
JWT_ACCESS_SECRET=''
JWT_ACCESS_TTL='15m'
JWT_REFRESH_SECRET=''
JWT_REFRESH_TTL='30d'


# Dynamics 365 FO Integration
D365FO_TENANT_ID=18628f3c-d584-4e0f-91cd-5a2f04a0d8cb
D365FO_CLIENT_ID=c828935e-be5c-4956-8996-ff0aad6ec80e
D365FO_CLIENT_SECRET=*******************
D365FO_RESOURCE=https://mesco.sandbox.operations.eu.dynamics.com
D365FO_AUTHORITY=https://login.microsoftonline.com


# Resilience Configuration
CIRCUIT_BREAKER_TIMEOUT=120000
CIRCUIT_BREAKER_RESET_TIMEOUT=120000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
CIRCUIT_BREAKER_ENABLED=true

CACHE_L1_TTL=5
CACHE_L2_TTL=30
CACHE_L3_TTL=120


